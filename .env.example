# The public workflow is free-only by default. Paid and redistribution-restricted
# adapters are excluded even if credentials are present.
MEMORYPULSE_FREE_ONLY=true

# Permission-gated and excluded from the public historical pipeline.
BESTBUY_API_KEY=

# Optional official U.S. memory integrated-circuit trade data.
CENSUS_API_KEY=

# Required by SEC fair-access policy before the Micron Company Facts adapter runs.
SEC_CONTACT_EMAIL=

# Optional licensed adapter for private experiments only. It is excluded while
# MEMORYPULSE_FREE_ONLY is true.
KEEPA_API_KEY=
KEEPA_DDR5_ASINS=
KEEPA_PUBLIC_EXPORT_ACKNOWLEDGED=false

# Optional operational tuning.
MEMORYPULSE_USER_AGENT=MemoryPulse/1.0 (+https://github.com/Photon7777/memorypulse; public research project)
MEMORYPULSE_HTTP_TIMEOUT=30
