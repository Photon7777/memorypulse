# Permission-gated. Best Buy content cannot be retained in the public historical archive
# without written permission under the current 72-hour caching restriction.
BESTBUY_API_KEY=

# Optional official U.S. memory integrated-circuit trade data.
CENSUS_API_KEY=

# Required by SEC fair-access policy before the Micron Company Facts adapter runs.
SEC_CONTACT_EMAIL=

# Optional licensed historical DDR5 product panel. Only set the acknowledgement after
# confirming that the subscription permits the intended public dataset distribution.
KEEPA_API_KEY=
KEEPA_DDR5_ASINS=
KEEPA_PUBLIC_EXPORT_ACKNOWLEDGED=false

# Optional operational tuning.
MEMORYPULSE_USER_AGENT=MemoryPulse/1.0 (+https://github.com/Photon7777/memorypulse; public research project)
MEMORYPULSE_HTTP_TIMEOUT=30
